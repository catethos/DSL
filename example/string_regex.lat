// Example: Using regex_match() for pattern matching
// regex_match(text, pattern) returns true if pattern matches anywhere in text

// Basic regex patterns
let text = "Hello, World!"
print("Text:", text)
print("Matches 'Wor.d' (. = any char):", regex_match(text, "Wor.d"))
print("Matches '^Hello' (starts with):", regex_match(text, "^Hello"))
print("Matches 'World!$' (ends with):", regex_match(text, "World!$"))
print("Matches '^World' (starts with World):", regex_match(text, "^World"))

// Word boundaries with \b
print("\n--- Word Boundaries ---")
let sentence = "he helped the other helper"
print("Sentence:", sentence)
print("Has standalone 'he':", regex_match(sentence, "\\bhe\\b"))
print("Has standalone 'helper':", regex_match(sentence, "\\bhelper\\b"))

// Character classes
print("\n--- Character Classes ---")
let mixed = "abc123xyz"
print("Text:", mixed)
print("Has digits:", regex_match(mixed, "[0-9]+"))
print("Has letters:", regex_match(mixed, "[a-z]+"))

// Alternation (OR patterns)
print("\n--- Alternation ---")
let fruit = "I like apples and oranges"
print("Text:", fruit)
print("Has apple or banana:", regex_match(fruit, "apple|banana"))
print("Has grape or orange:", regex_match(fruit, "grape|orange"))

// Case insensitive matching - two ways:
// 1. Using (?i) in the pattern
// 2. Using the third parameter: regex_match(text, pattern, true)
print("\n--- Case Insensitive ---")
let greeting = "HELLO world"
print("Text:", greeting)
print("Matches 'hello' (case sensitive):", regex_match(greeting, "hello"))
print("Matches with (?i) prefix:", regex_match(greeting, "(?i)hello"))
print("Matches with flag=true:", regex_match(greeting, "hello", true))

// Practical example: Pronoun detection
print("\n--- Pronoun Detection Example ---")
let text1 = "The employee completed the task efficiently"
let text2 = "He completed the task and she reviewed it"

let pronoun_pattern = "\\b(he|she|him|her|his|hers|himself|herself)\\b"

print("Text 1:", text1)
print("Has pronouns:", regex_match(text1, pronoun_pattern, true))

print("Text 2:", text2)
print("Has pronouns:", regex_match(text2, pronoun_pattern, true))

// Pronouns at start of sentence (capital letters)
let text3 = "She went to the store"
let text4 = "He said hello"
print("\nText 3:", text3)
print("Has pronouns (case-insensitive):", regex_match(text3, pronoun_pattern, true))
print("Text 4:", text4)
print("Has pronouns (case-insensitive):", regex_match(text4, pronoun_pattern, true))

// Without case-insensitive flag, capitalized pronouns won't match
print("\nWithout case-insensitive flag:")
print("'She went...' matches lowercase pattern:", regex_match(text3, pronoun_pattern, false))

// Final result
regex_match(text2, pronoun_pattern, true)
