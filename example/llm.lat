// =============================================================================
// Lattice LLM Functions: AI-Powered Type-Safe Function Definitions
// =============================================================================
//
// This example demonstrates Lattice's unique feature: LLM-backed functions
// that use large language models to process inputs and return typed outputs.
//
// NOTE: To run LLM functions, you need to configure:
// - API base URL (e.g., OpenAI-compatible endpoint)
// - API key via environment variable
// - Model name
// =============================================================================

// -----------------------------------------------------------------------------
// Type Definitions for LLM Functions
// -----------------------------------------------------------------------------

// Output type for sentiment analysis
enum Sentiment {
    Positive,
    Negative,
    Neutral,
    Mixed
}

// Output type for entity extraction
type Entity {
    name: String @"The entity name",
    entity_type: String @"Entity type: PERSON, ORG, LOCATION, DATE, etc.",
    confidence: Float @"Confidence score from 0.0 to 1.0"
}

// Output type for summarization
type Summary {
    title: String @"A brief title for the content",
    summary: String @"The summarized content in 2-3 sentences",
    key_points: [String] @"List of main points extracted"
}

// Output type for classification
type Classification {
    category: String @"The assigned category",
    confidence: Float @"Confidence score from 0.0 to 1.0",
    reasoning: String @"Explanation for the classification"
}

// Output type for translation
type Translation {
    original: String @"Original text",
    translated: String @"Translated text",
    source_language: String @"Detected source language",
    target_language: String @"Target language"
}

// Output type for Q&A
type Answer {
    answer: String @"The answer to the question",
    confidence: Float @"Confidence score",
    sources: [String]? @"Optional source references"
}

// -----------------------------------------------------------------------------
// Basic LLM Function: Sentiment Analysis
// -----------------------------------------------------------------------------

// An LLM function uses curly braces with config and prompt
def analyze_sentiment(text: String) -> Sentiment {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.0

    prompt: """
    Analyze the sentiment of the following text and classify it as one of:
    - Positive: Expresses positive emotions, satisfaction, or optimism
    - Negative: Expresses negative emotions, dissatisfaction, or pessimism
    - Neutral: Factual, objective, or emotionally neutral
    - Mixed: Contains both positive and negative sentiments

    Text to analyze:
    ${text}

    Return only the sentiment classification.
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Entity Extraction
// -----------------------------------------------------------------------------

def extract_entities(text: String) -> [Entity] {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.0

    prompt: """
    Extract all named entities from the following text.

    For each entity, provide:
    - name: The entity as it appears in the text
    - type: One of PERSON, ORG, LOCATION, DATE, PRODUCT, EVENT
    - confidence: Your confidence score from 0.0 to 1.0

    Text:
    ${text}

    Return the entities as a JSON array.
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Text Summarization
// -----------------------------------------------------------------------------

def summarize(text: String, max_length: Int) -> Summary {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.3
    max_tokens: 500

    prompt: """
    Summarize the following text in no more than ${max_length} words.

    Provide:
    1. A brief title (max 10 words)
    2. A concise summary (2-3 sentences)
    3. A list of 3-5 key points

    Text to summarize:
    ${text}
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Text Classification
// -----------------------------------------------------------------------------

def classify_text(text: String, categories: [String]) -> Classification {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.0

    prompt: """
    Classify the following text into one of these categories: ${categories}

    Text: ${text}

    Provide:
    - category: The most appropriate category from the list
    - confidence: Your confidence score (0.0 to 1.0)
    - reasoning: A brief explanation for your choice
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Translation
// -----------------------------------------------------------------------------

def translate(text: String, target_language: String) -> Translation {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.3

    prompt: """
    Translate the following text to ${target_language}.

    Original text:
    ${text}

    Provide:
    - original: The original text
    - translated: The translated text
    - source_language: The detected source language
    - target_language: "${target_language}"
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Question Answering
// -----------------------------------------------------------------------------

def answer_question(context: String, question: String) -> Answer {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.2

    prompt: """
    Based on the following context, answer the question.

    Context:
    ${context}

    Question: ${question}

    Provide:
    - answer: Your answer based on the context
    - confidence: How confident you are (0.0 to 1.0)
    - sources: Relevant quotes from the context (if applicable)

    If the answer cannot be found in the context, say so and set confidence to 0.
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Code Generation
// -----------------------------------------------------------------------------

type CodeResult {
    code: String @"The generated code",
    language: String @"Programming language",
    explanation: String @"Explanation of how the code works"
}

def generate_code(description: String, language: String) -> CodeResult {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.2
    max_tokens: 1000

    prompt: """
    Generate ${language} code that does the following:
    ${description}

    Provide:
    - code: The complete, working code
    - language: "${language}"
    - explanation: A brief explanation of how the code works

    Make sure the code is clean, well-commented, and follows best practices.
    """
}

// -----------------------------------------------------------------------------
// LLM Function: Data Extraction (Structured)
// -----------------------------------------------------------------------------

type ContactInfo {
    name: String?,
    email: String?,
    phone: String?,
    company: String?,
    title: String?
}

def extract_contact(text: String) -> ContactInfo {
    base_url: "https://api.openai.com/v1"
    model: "gpt-4"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.0

    prompt: """
    Extract contact information from the following text.

    Text:
    ${text}

    Extract (if present):
    - name: Person's full name
    - email: Email address
    - phone: Phone number
    - company: Company or organization
    - title: Job title or position

    Use null for any fields not found in the text.
    """
}

