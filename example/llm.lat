// -----------------------------------------------------------------------------
// Using Different LLM Providers
// -----------------------------------------------------------------------------

// Example: Using a local LLM via Ollama
def local_summarize(text: String) -> Summary {
    base_url: "http://localhost:11434/v1"
    model: "llama2"
    api_key_env: "DUMMY_KEY"  // Ollama doesn't require a key
    temperature: 0.3

    prompt: """
    Summarize the following text:
    ${text}

    Provide a title, summary, and key points.
    """
}

// Example: Using Anthropic Claude
def claude_classify(text: String) -> Classification {
    base_url: "https://api.anthropic.com/v1"
    model: "claude-3-sonnet-20240229"
    api_key_env: "ANTHROPIC_API_KEY"
    temperature: 0.0

    prompt: """
    Classify this text into one of: Technical, Business, Personal, News

    Text: ${text}

    Return category, confidence, and reasoning.
    """
}

