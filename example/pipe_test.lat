// Test pipe operator

def double(x: Int) -> Int {
    x * 2
}

def add_one(x: Int) -> Int {
    x + 1
}

// Simple pipe
let nums = [1, 2, 3]
let result1 = nums |> len()
print("len via pipe:")
print(result1)

// Chained pipes
let result2 = 5 |> double() |> add_one()
print("5 |> double() |> add_one():")
print(result2)

// Pipe with arguments
def add(a: Int, b: Int) -> Int {
    a + b
}

let result3 = 10 |> add(5)
print("10 |> add(5):")
print(result3)

print("Pipe operator tests passed!")
